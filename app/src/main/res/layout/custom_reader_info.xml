<?xml version="1.0" encoding="utf-8"?>
<!-- 现代化阅读器信息胶囊：圆角半透明背景，右上角常驻显示页码/时钟/电量 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_info_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentEnd="true"
    android:layout_alignParentTop="true"
    android:layout_margin="12dp"
    android:background="@drawable/bg_reader_info_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/reader_chapter_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <com.xyrlsz.xcimocob.ui.widget.MiniClockText
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/reader_battery_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/reader_battery_icon">

        <View
            android:id="@+id/reader_battery_icon_fill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="5.5dp"
            android:layout_marginEnd="5.5dp"
            android:layout_marginBottom="2.85dp"
            android:background="@drawable/bg_battery_fill"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/reader_battery_icon_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_battery_outline" />
    </FrameLayout>

    <TextView
        android:id="@+id/reader_battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:textColor="@color/white"
        android:textSize="12sp" />
</LinearLayout>